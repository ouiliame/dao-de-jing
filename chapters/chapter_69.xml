<?xml version="1.0" encoding="UTF-8"?>
<chapter number="69">
<line commentary="In military affairs, there is a saying:">
    <word original="." calque="." punctuation="true"/>
    <word original="用兵" pinyin="yòng bīng" calque="use-military"/>
    <word original="有" pinyin="yǒu" calque="have"/>
    <word original="言" pinyin="yán" calque="saying"/>
</line>

<line commentary="I dare not be the host, but rather be the guest.">
    <word original="吾" pinyin="wú" calque="I"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="敢" pinyin="gǎn" calque="dare"/>
    <word original="為" pinyin="wéi" calque="act-as"/>
    <word original="主" pinyin="zhǔ" calque="host"/>
    <word original="而" pinyin="ér" calque="but"/>
    <word original="為" pinyin="wéi" calque="act-as"/>
    <word original="客" pinyin="kè" calque="guest"/>
</line>

<line commentary="I dare not advance an inch, but retreat a foot.">
    <word original="不" pinyin="bù" calque="not"/>
    <word original="敢" pinyin="gǎn" calque="dare"/>
    <word original="進" pinyin="jìn" calque="advance"/>
    <word original="寸" pinyin="cùn" calque="inch"/>
    <word original="而" pinyin="ér" calque="but"/>
    <word original="退" pinyin="tuì" calque="retreat"/>
    <word original="尺" pinyin="chǐ" calque="foot"/>
</line>

<line commentary="This is called marching without marching.">
    <word original="是" pinyin="shì" calque="this"/>
    <word original="謂" pinyin="wèi" calque="called"/>
    <word original="行" pinyin="xíng" calque="march"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="行" pinyin="xíng" calque="marching"/>
</line>

<line commentary="Rolling up sleeves without arms.">
    <word original="攘" pinyin="rǎng" calque="roll-up"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="臂" pinyin="bì" calque="arms"/>
    <word original="." calque="." punctuation="true"/>
</line>

<line commentary="Grasping without weapons.">
    <word original="扔" pinyin="rēng" calque="grasp"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="敵" pinyin="dí" calque="enemy"/>
</line>

<line commentary="Confronting without troops.">
    <word original="執" pinyin="zhí" calque="hold"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="兵" pinyin="bīng" calque="troops"/>
</line>

<line commentary="No disaster is greater than underestimating the enemy.">
    <word original="禍" pinyin="huò" calque="disaster"/>
    <word original="莫" pinyin="mò" calque="none"/>
    <word original="大" pinyin="dà" calque="greater"/>
    <word original="於" pinyin="yú" calque="than"/>
    <word original="輕" pinyin="qīng" calque="treat-lightly"/>
    <word original="敵" pinyin="dí" calque="enemy"/>
</line>

<line commentary="Underestimating the enemy nearly loses my treasure.">
    <word original="輕" pinyin="qīng" calque="treat-lightly"/>
    <word original="敵" pinyin="dí" calque="enemy"/>
    <word original="幾" pinyin="jī" calque="nearly"/>
    <word original="喪" pinyin="sàng" calque="lose"/>
    <word original="吾" pinyin="wú" calque="my"/>
    <word original="寶" pinyin="bǎo" calque="treasure"/>
    <word original="." calque="." punctuation="true"/>
</line>

<line commentary="Therefore when armies oppose each other,">
    <word original="(故)" pinyin="gù" calque="therefore"/>
    <word original="抗" pinyin="kàng" calque="oppose"/>
    <word original="兵" pinyin="bīng" calque="armies"/>
    <word original="相" pinyin="xiāng" calque="mutually"/>
    <word original="(若)" pinyin="ruò" calque="(like)"/>
</line>

<line commentary="The sorrowful one will be victorious.">
    <word original="[則]" pinyin="zé" calque="[then]"/>
    <word original="哀" pinyin="āi" calque="sorrowful"/>
    <word original="者" pinyin="zhě" calque="one"/>
    <word original="勝" pinyin="shèng" calque="victory"/>
    <word original="矣" pinyin="yǐ" calque="indeed"/>
    <word original="(.)" calque="(.)" punctuation="true"/>
</line>
</chapter>