<?xml version="1.0" encoding="UTF-8"?>
<chapter number="16">
<line commentary="Achieve utmost emptiness.">
    <word original="致" pinyin="zhì" calque="achieve"/>
    <word original="虛" pinyin="xū" calque="empty"/>
    <word original="極" pinyin="jí" calque="utmost"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Maintain profound quietude.">
    <word original="守" pinyin="shǒu" calque="maintain"/>
    <word original="靜" pinyin="jìng" calque="quiet"/>
    <word original="篤" pinyin="dǔ" calque="profound"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="The ten thousand things arise together.">
    <word original="萬" pinyin="wàn" calque="ten-thousand"/>
    <word original="物" pinyin="wù" calque="things"/>
    <word original="並" pinyin="bìng" calque="together"/>
    <word original="作" pinyin="zuò" calque="arise"/>
</line>

<line commentary="I thereby observe their return.">
    <word original="吾" pinyin="wú" calque="I"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="觀" pinyin="guān" calque="observe"/>
    <word original="[其]" pinyin="qí" calque="[their]"/>
    <word original="復" pinyin="fù" calque="return"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Now, all things flourish abundantly, each returning to its root.">
    <word original="(.)夫" pinyin="fú" calque="(now)"/>
    <word original="物" pinyin="wù" calque="things"/>
    <word original="芸芸" pinyin="yúnyún" calque="abundant"/>
    <word original="各" pinyin="gè" calque="each"/>
    <word original="復" pinyin="fù" calque="return"/>
    <word original="歸" pinyin="guī" calque="return-to"/>
    <word original="其" pinyin="qí" calque="its"/>
    <word original="根" pinyin="gēn" calque="root"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Returning to the root is called quietude.">
    <word original="歸" pinyin="guī" calque="return-to"/>
    <word original="根" pinyin="gēn" calque="root"/>
    <word original="曰" pinyin="yuē" calque="called"/>
    <word original="靜" pinyin="jìng" calque="quiet"/>
</line>

<line commentary="This quietude is called returning to one's destiny.">
    <word original="[靜]" pinyin="jìng" calque="[quietude]"/>
    <word original="是" pinyin="shì" calque="this"/>
    <word original="謂" pinyin="wèi" calque="called"/>
    <word original="復" pinyin="fù" calque="return"/>
    <word original="命" pinyin="mìng" calque="destiny"/>
</line>

<line commentary="Returning to destiny is called constancy.">
    <word original="復" pinyin="fù" calque="return"/>
    <word original="命" pinyin="mìng" calque="destiny"/>
    <word original="曰" pinyin="yuē" calque="called"/>
    <word original="常" pinyin="cháng" calque="constant"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Knowing constancy is called enlightenment.">
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="常" pinyin="cháng" calque="constant"/>
    <word original="曰" pinyin="yuē" calque="called"/>
    <word original="明" pinyin="míng" calque="bright"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Not knowing constancy leads to reckless action and misfortune.">
    <word original="不" pinyin="bù" calque="not"/>
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="常" pinyin="cháng" calque="constant"/>
    <word original="妄" pinyin="wàng" calque="reckless"/>
    <word original="作" pinyin="zuò" calque="act"/>
    <word original="凶" pinyin="xiōng" calque="misfortune"/>
</line>

<line commentary="Knowing constancy leads to capacity.">
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="常" pinyin="cháng" calque="constant"/>
    <word original="容" pinyin="róng" calque="capacity"/>
</line>

<line commentary="Capacity leads to inclusiveness.">
    <word original="容" pinyin="róng" calque="capacity"/>
    <word original="乃" pinyin="nǎi" calque="leads-to"/>
    <word original="公" pinyin="gōng" calque="inclusive"/>
</line>

<line commentary="Inclusiveness leads to kingliness.">
    <word original="公" pinyin="gōng" calque="inclusive"/>
    <word original="乃" pinyin="nǎi" calque="leads-to"/>
    <word original="王" pinyin="wáng" calque="king"/>
</line>

<line commentary="Kingliness leads to heaven.">
    <word original="王" pinyin="wáng" calque="king"/>
    <word original="乃" pinyin="nǎi" calque="leads-to"/>
    <word original="天" pinyin="tiān" calque="heaven"/>
</line>

<line commentary="Heaven leads to the Way.">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="乃" pinyin="nǎi" calque="leads-to"/>
    <word original="道" pinyin="dào" calque="way"/>
</line>

<line commentary="The Way leads to endurance.">
    <word original="道" pinyin="dào" calque="way"/>
    <word original="乃" pinyin="nǎi" calque="leads-to"/>
    <word original="久" pinyin="jiǔ" calque="enduring"/>
</line>

<line commentary="Until the end of one's life, there is no danger.">
    <word original="沒" pinyin="mò" calque="end"/>
    <word original="身" pinyin="shēn" calque="body"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="殆" pinyin="dài" calque="danger"/>
</line>
</chapter>