<?xml version="1.0" encoding="UTF-8"?>
<chapter number="26">
<line commentary="Heaviness is the root of lightness.">
    <word original="重" pinyin="zhòng" calque="heavy"/>
    <word original="為" pinyin="wéi" calque="becomes"/>
    <word original="輕" pinyin="qīng" calque="light"/>
    <word original="根" pinyin="gēn" calque="root"/>
</line>

<line commentary="Stillness is the master of restlessness.">
    <word original="靜" pinyin="jìng" calque="still"/>
    <word original="為" pinyin="wéi" calque="becomes"/>
    <word original="躁" pinyin="zào" calque="restless"/>
    <word original="君" pinyin="jūn" calque="ruler"/>
</line>

<line commentary="Therefore the noble person throughout the day">
    <word original="是" pinyin="shì" calque="this"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="(君子)" pinyin="jūnzǐ" calque="noble-person"/>
    <word original="終" pinyin="zhōng" calque="throughout"/>
    <word original="日" pinyin="rì" calque="day"/>
</line>

<line commentary="Travels without leaving their supply wagons.">
    <word original="行" pinyin="xíng" calque="travel"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="離" pinyin="lí" calque="leave"/>
    <word original="[其]" pinyin="qí" calque="their"/>
    <word original="輜" pinyin="zī" calque="wagon"/>
</line>

<line commentary="Though there are magnificent sights to see,">
    <word original="重" pinyin="zhòng" calque="heavy"/>
    <word original="雖" pinyin="suī" calque="although"/>
    <word original="有" pinyin="yǒu" calque="have"/>
    <word original="榮" pinyin="róng" calque="glory"/>
    <word original="觀" pinyin="guān" calque="view"/>
    <word original="燕" pinyin="yàn" calque="feast"/>
</line>

<line commentary="They remain serenely unattached.">
    <word original="處" pinyin="chǔ" calque="dwell"/>
    <word original="超" pinyin="chāo" calque="transcend"/>
    <word original="然" pinyin="rán" calque="thus"/>
</line>

<line commentary="How can the lord of ten thousand chariots">
    <word original="奈" pinyin="nài" calque="how"/>
    <word original="何" pinyin="hé" calque="what"/>
    <word original="萬" pinyin="wàn" calque="ten-thousand"/>
    <word original="乘" pinyin="shèng" calque="chariots"/>
    <word original="之" pinyin="zhī" calque="of"/>
    <word original="主" pinyin="zhǔ" calque="lord"/>
</line>

<line commentary="Treat their body lightly in governing the world?">
    <word original="而" pinyin="ér" calque="yet"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="身" pinyin="shēn" calque="body"/>
    <word original="輕" pinyin="qīng" calque="light"/>
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="下" pinyin="xià" calque="below"/>
</line>

<line commentary="In lightness, the root is lost.">
    <word original="輕" pinyin="qīng" calque="light"/>
    <word original="則" pinyin="zé" calque="then"/>
    <word original="失" pinyin="shī" calque="lose"/>
    <word original="本" pinyin="běn" calque="root"/>
</line>

<line commentary="In restlessness, mastery is lost.">
    <word original="躁" pinyin="zào" calque="restless"/>
    <word original="則" pinyin="zé" calque="then"/>
    <word original="失" pinyin="shī" calque="lose"/>
    <word original="君" pinyin="jūn" calque="ruler"/>
</line>
</chapter>