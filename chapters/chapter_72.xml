<?xml version="1.0" encoding="UTF-8"?>
<chapter number="72">
<line commentary="When people do not fear authority,">
    <word original="民" pinyin="mín" calque="people"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="畏" pinyin="wèi" calque="fear"/>
    <word original="威" pinyin="wēi" calque="authority"/>
</line>

<line commentary="Then great authority will arrive indeed.">
    <word original="則" pinyin="zé" calque="then"/>
    <word original="大" pinyin="dà" calque="great"/>
    <word original="威" pinyin="wēi" calque="authority"/>
    <word original="至" pinyin="zhì" calque="arrive"/>
    <word original="[矣(.)]" pinyin="yǐ" calque="[indeed(.)]"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Do not restrict where they dwell,">
    <word original="無" pinyin="wú" calque="do-not"/>
    <word original="狎" pinyin="xiá" calque="restrict"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="所" pinyin="suǒ" calque="place"/>
    <word original="居" pinyin="jū" calque="dwell"/>
</line>

<line commentary="Do not weary them in their livelihood.">
    <word original="無" pinyin="wú" calque="do-not"/>
    <word original="厭" pinyin="yàn" calque="weary"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="所" pinyin="suǒ" calque="that-which"/>
    <word original="生" pinyin="shēng" calque="live"/>
</line>

<line commentary="It is because you do not oppress them,">
    <word original="(.)夫" pinyin="fú" calque="(.)indeed"/>
    <word original="唯" pinyin="wéi" calque="only"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="厭" pinyin="yàn" calque="oppress"/>
</line>

<line commentary="Therefore they will not be wearied.">
    <word original="是" pinyin="shì" calque="this"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="厭" pinyin="yàn" calque="weary"/>
</line>

<line commentary="Therefore the sage">
    <word original="是" pinyin="shì" calque="this"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="聖" pinyin="shèng" calque="sage"/>
    <word original="人" pinyin="rén" calque="person"/>
</line>

<line commentary="Knows himself but does not display himself.">
    <word original="自" pinyin="zì" calque="self"/>
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="自" pinyin="zì" calque="self"/>
    <word original="見" pinyin="xiàn" calque="display"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Loves himself but does not exalt himself.">
    <word original="自" pinyin="zì" calque="self"/>
    <word original="愛" pinyin="ài" calque="love"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="自" pinyin="zì" calque="self"/>
    <word original="貴" pinyin="guì" calque="value"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Therefore he rejects that and chooses this.">
    <word original="(.)故" pinyin="gù" calque="(.)therefore"/>
    <word original="去" pinyin="qù" calque="reject"/>
    <word original="彼" pinyin="bǐ" calque="that"/>
    <word original="取" pinyin="qǔ" calque="choose"/>
    <word original="此" pinyin="cǐ" calque="this"/>
</line>
</chapter>