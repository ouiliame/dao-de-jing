<chapter number="55">
<line commentary="One who possesses profound virtue">
    <word original="含" pinyin="hán" calque="contain"/>
    <word original="德" pinyin="dé" calque="virtue"/>
    <word original="之" pinyin="zhī" calque="of"/>
    <word original="厚" pinyin="hòu" calque="thick"/>
    <word original="[者]" pinyin="zhě" calque="[one-who]"/>
</line>

<line commentary="Is comparable to a newborn child">
    <word original="比" pinyin="bǐ" calque="compare"/>
    <word original="於" pinyin="yú" calque="to"/>
    <word original="赤" pinyin="chì" calque="red"/>
    <word original="子" pinyin="zǐ" calque="child"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Wasps, scorpions, vipers, and snakes do not sting it">
