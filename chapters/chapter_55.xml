    <word original="蠆" pinyin="chài" calque="scorpion"/>
    <word original="虺" pinyin="huǐ" calque="viper"/>
    <word original="蛇" pinyin="shé" calque="snake"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="螫" pinyin="shì" calque="sting"/>
</line>

<line commentary="Fierce beasts do not seize it">
