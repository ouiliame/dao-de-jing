    <word original="弱" pinyin="ruò" calque="weak"/>
    <word original="筋" pinyin="jīn" calque="sinew"/>
    <word original="柔" pinyin="róu" calque="soft"/>
    <word original="而" pinyin="ér" calque="yet"/>
    <word original="握" pinyin="wò" calque="grip"/>
