    <word original="知" pinyin="zhī" calque="know"/>
    <word original="牝" pinyin="pìn" calque="female"/>
    <word original="牡" pinyin="mǔ" calque="male"/>
    <word original="之" pinyin="zhī" calque="of"/>
    <word original="合" pinyin="hé" calque="union"/>
    <word original="而" pinyin="ér" calque="yet"/>
    <word original="(脧)" pinyin="xuān" calque="(vital-force)"/>
    <word original="作" pinyin="zuò" calque="arise"/>
</line>

<line commentary="This is the perfection of essence">
