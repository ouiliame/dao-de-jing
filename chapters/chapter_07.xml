<?xml version="1.0" encoding="UTF-8"?>
<chapter number="7">
<line commentary="Heaven is lasting and Earth enduring.">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="長" pinyin="cháng" calque="lasting"/>
    <word original="地" pinyin="dì" calque="earth"/>
    <word original="久" pinyin="jiǔ" calque="enduring"/>
</line>

<line commentary="The reason Heaven and Earth can be lasting and enduring is">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="地" pinyin="dì" calque="earth"/>
    <word original="所以" pinyin="suǒyǐ" calque="reason-why"/>
    <word original="能" pinyin="néng" calque="can"/>
    <word original="長" pinyin="cháng" calque="lasting"/>
    <word original="且" pinyin="qiě" calque="and"/>
    <word original="久" pinyin="jiǔ" calque="enduring"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
</line>

<line commentary="Because they do not live for themselves.">
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="自" pinyin="zì" calque="self"/>
    <word original="生" pinyin="shēng" calque="live"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Thus they can live long.">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="能" pinyin="néng" calque="can"/>
    <word original="長" pinyin="cháng" calque="long"/>
    <word original="生" pinyin="shēng" calque="live"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Therefore the sage:">
    <word original="是" pinyin="shì" calque="this"/>
    <word original="以" pinyin="yǐ" calque="thus"/>
    <word original="聖" pinyin="shèng" calque="sage"/>
    <word original="人" pinyin="rén" calque="person"/>
</line>

<line commentary="Puts self last but ends up in front.">
    <word original="後" pinyin="hòu" calque="behind"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="身" pinyin="shēn" calque="body"/>
    <word original="而" pinyin="ér" calque="yet"/>
    <word original="身" pinyin="shēn" calque="body"/>
    <word original="先" pinyin="xiān" calque="ahead"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Puts self outside but self remains.">
    <word original="外" pinyin="wài" calque="outside"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="身" pinyin="shēn" calque="body"/>
    <word original="而" pinyin="ér" calque="yet"/>
    <word original="身" pinyin="shēn" calque="body"/>
    <word original="存" pinyin="cún" calque="exists"/>
</line>

<line commentary="Is it not because they have no self-interest?">
    <word original="非" pinyin="fēi" calque="is-not"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="私" pinyin="sī" calque="private"/>
    <word original="邪" pinyin="xié" calque="question"/>
    <word original="(." pinyin="" calque=")" punctuation="true"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Therefore they can fulfill their own interests.">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="能" pinyin="néng" calque="can"/>
    <word original="成" pinyin="chéng" calque="accomplish"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="私" pinyin="sī" calque="private"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>
