<chapter number="60">
<line commentary="Governing a large country is like cooking small fish.">
    <word original="治" pinyin="zhì" calque="govern"/>
    <word original="大" pinyin="dà" calque="great"/>
    <word original="國" pinyin="guó" calque="country"/>
    <word original="若" pinyin="ruò" calque="like"/>
    <word original="烹" pinyin="pēng" calque="cook"/>
    <word original="小" pinyin="xiǎo" calque="small"/>
    <word original="鮮" pinyin="xiān" calque="fish"/>
</line>

<line commentary="When using the Way to oversee the world,">
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="道" pinyin="dào" calque="way"/>
    <word original="莅" pinyin="lì" calque="oversee"/>
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="下" pinyin="xià" calque="below"/>
</line>

<line commentary="Their spirits will not be supernatural.">
    <word original="其" pinyin="qí" calque="their"/>
    <word original="鬼" pinyin="guǐ" calque="spirits"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="神" pinyin="shén" calque="divine"/>
</line>

<line commentary="It's not that their spirits are not supernatural.">
    <word original="非" pinyin="fēi" calque="not"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="鬼" pinyin="guǐ" calque="spirits"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="神" pinyin="shén" calque="divine"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Their divinity will not harm people.">
    <word original="其" pinyin="qí" calque="their"/>
    <word original="神" pinyin="shén" calque="divine"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="傷" pinyin="shāng" calque="harm"/>
    <word original="人" pinyin="rén" calque="person"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="It's not that their divinity cannot harm people.">
    <word original="非" pinyin="fēi" calque="not"/>
    <word original="其" pinyin="qí" calque="their"/>
    <word original="神" pinyin="shén" calque="divine"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="傷" pinyin="shāng" calque="harm"/>
    <word original="人" pinyin="rén" calque="person"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="The sage also does not harm people.">
    <word original="聖" pinyin="shèng" calque="sage"/>
    <word original="人" pinyin="rén" calque="person"/>
    <word original="亦" pinyin="yì" calque="also"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="傷" pinyin="shāng" calque="harm"/>
    <word original="人" pinyin="rén" calque="person"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="When these two do not harm each other,">
    <word original="夫" pinyin="fú" calque="thus"/>
    <word original="兩" pinyin="liǎng" calque="two"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="相" pinyin="xiāng" calque="mutually"/>
    <word original="傷" pinyin="shāng" calque="harm"/>
</line>

<line commentary="Therefore their virtues merge and return as one.">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="德" pinyin="dé" calque="virtue"/>
    <word original="交" pinyin="jiāo" calque="exchange"/>
    <word original="歸" pinyin="guī" calque="return"/>
    <word original="焉" pinyin="yān" calque="therein"/>
</line>
