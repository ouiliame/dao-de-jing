<?xml version="1.0" encoding="UTF-8"?>
<chapter number="29">
<line commentary="When one desires to take control of the world and act upon it,">
    <word original="將" pinyin="jiāng" calque="about-to"/>
    <word original="欲" pinyin="yù" calque="desire"/>
    <word original="取" pinyin="qǔ" calque="take"/>
    <word original="天下" pinyin="tiān-xià" calque="all-under-heaven"/>
    <word original="而" pinyin="ér" calque="and"/>
    <word original="為" pinyin="wéi" calque="do"/>
    <word original="之" pinyin="zhī" calque="it"/>
</line>

<line commentary="I observe that they will certainly fail.">
    <word original="吾" pinyin="wú" calque="I"/>
    <word original="見" pinyin="jiàn" calque="see"/>
    <word original="其" pinyin="qí" calque="its"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="得" pinyin="dé" calque="obtain"/>
    <word original="已" pinyin="yǐ" calque="already"/>
</line>

<line commentary="For the world is a sacred vessel.">
    <word original="[(.)夫]" pinyin="fú" calque="indeed"/>
    <word original="天下" pinyin="tiān-xià" calque="all-under-heaven"/>
    <word original="神器" pinyin="shén-qì" calque="sacred-vessel"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="It cannot be acted upon.">
    <word original="不" pinyin="bù" calque="not"/>
    <word original="可" pinyin="kě" calque="can"/>
    <word original="為" pinyin="wéi" calque="do"/>
    <word original="也" pinyin="yě" calque="indeed"/>
    <word original="(.)" pinyin="" calque="(.)" punctuation="true"/>
</line>

<line commentary="Those who act upon it will ruin it.">
    <word original="為" pinyin="wéi" calque="do"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="敗" pinyin="bài" calque="ruin"/>
    <word original="之" pinyin="zhī" calque="it"/>
</line>

<line commentary="Those who grasp it will lose it.">
    <word original="執" pinyin="zhí" calque="grasp"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="失" pinyin="shī" calque="lose"/>
    <word original="之" pinyin="zhī" calque="it"/>
</line>

<line commentary="Therefore in all things:">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="物" pinyin="wù" calque="things"/>
</line>

<line commentary="Some lead, some follow,">
    <word original="或" pinyin="huò" calque="some"/>
    <word original="行" pinyin="xíng" calque="walk"/>
    <word original="或" pinyin="huò" calque="some"/>
    <word original="隨" pinyin="suí" calque="follow"/>
</line>

<line commentary="Some breathe gently, some breathe strongly,">
    <word original="或" pinyin="huò" calque="some"/>
    <word original="(歔)" pinyin="xū" calque="inhale"/>
    <word original="或" pinyin="huò" calque="some"/>
    <word original="吹" pinyin="chuī" calque="blow"/>
</line>

<line commentary="Some are strong, some are weak,">
    <word original="或" pinyin="huò" calque="some"/>
    <word original="強" pinyin="qiáng" calque="strong"/>
    <word original="或" pinyin="huò" calque="some"/>
    <word original="羸" pinyin="léi" calque="weak"/>
</line>

<line commentary="Some break down, some fall apart.">
    <word original="或" pinyin="huò" calque="some"/>
    <word original="挫" pinyin="cuò" calque="break"/>
    <word original="或" pinyin="huò" calque="some"/>
    <word original="隳" pinyin="huī" calque="collapse"/>
</line>

<line commentary="Therefore the sage:">
    <word original="是" pinyin="shì" calque="this"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="聖人" pinyin="shèng-rén" calque="sage-person"/>
</line>

<line commentary="Eliminates excess,">
    <word original="去" pinyin="qù" calque="remove"/>
    <word original="甚" pinyin="shèn" calque="excessive"/>
</line>

<line commentary="Eliminates extravagance,">
    <word original="去" pinyin="qù" calque="remove"/>
    <word original="奢" pinyin="shē" calque="extravagant"/>
</line>

<line commentary="Eliminates extremes.">
    <word original="去" pinyin="qù" calque="remove"/>
    <word original="泰" pinyin="tài" calque="extreme"/>
</line>
</chapter>