<chapter number="71">
<line commentary="To know what one does not know is highest.">
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="(尚)" pinyin="shàng" calque="(highest)"/>
    <word original="[矣(.)]" pinyin="yǐ" calque="[indeed(.)]"/>
</line>

<line commentary="Not knowing what one knows is affliction.">
    <word original="不" pinyin="bù" calque="not"/>
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="知" pinyin="zhī" calque="know"/>
    <word original="病" pinyin="bìng" calque="illness"/>
    <word original="[矣(.)]" pinyin="yǐ" calque="[indeed(.)]"/>
</line>

<line commentary="Indeed, it is by recognizing affliction as affliction,">
    <word original="(.)" pinyin="" calque="(.)"/>
    <word original="夫" pinyin="fú" calque="indeed"/>
    <word original="唯" pinyin="wéi" calque="only"/>
    <word original="病" pinyin="bìng" calque="illness"/>
    <word original="病" pinyin="bìng" calque="illness"/>
</line>

<line commentary="That one is free from affliction.">
