    <word original="[能]" pinyin="néng" calque="[can]"/>
    <word original="(大)" pinyin="dà" calque="(great)"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Were I to resemble greatness...">
    <word original="若" pinyin="ruò" calque="if"/>
    <word original="肖" pinyin="xiào" calque="resemble"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Long indeed would I have remained small.">
    <word original="久" pinyin="jiǔ" calque="long"/>
    <word original="矣" pinyin="yǐ" calque="already"/>
    <word original="其" pinyin="qí" calque="its"/>
    <word original="細" pinyin="xì" calque="small"/>
    <word original="也" pinyin="yě" calque="indeed"/>
    <word original="(.)" pinyin="" calque="(.)" punctuation="true"/>
</line>

<line commentary="Indeed, I have three treasures.">
    <word original="(.)夫" pinyin="fú" calque="(indeed)"/>
    <word original="我" pinyin="wǒ" calque="I"/>
    <word original="有" pinyin="yǒu" calque="have"/>
    <word original="三" pinyin="sān" calque="three"/>
    <word original="寶" pinyin="bǎo" calque="treasures"/>
</line>

<line commentary="Hold them and protect them.">
    <word original="持" pinyin="chí" calque="hold"/>
    <word original="而" pinyin="ér" calque="and"/>
    <word original="保" pinyin="bǎo" calque="protect"/>
    <word original="之" pinyin="zhī" calque="them"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="The first is called compassion.">
    <word original="一" pinyin="yī" calque="one"/>
    <word original="曰" pinyin="yuē" calque="called"/>
    <word original="慈" pinyin="cí" calque="compassion"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="The second is called frugality.">
    <word original="二" pinyin="èr" calque="two"/>
    <word original="曰" pinyin="yuē" calque="called"/>
    <word original="儉" pinyin="jiǎn" calque="frugality"/>
</line>

<line commentary="The third is called not daring to be ahead of all under heaven.">
    <word original="三" pinyin="sān" calque="three"/>
    <word original="曰" pinyin="yuē" calque="called"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="敢" pinyin="gǎn" calque="dare"/>
    <word original="為" pinyin="wéi" calque="be"/>
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="下" pinyin="xià" calque="below"/>
    <word original="先" pinyin="xiān" calque="first"/>
</line>

<line commentary="Through compassion, one can be courageous.">
    <word original="慈" pinyin="cí" calque="compassion"/>
    <word original="故" pinyin="gù" calque="therefore"/>
    <word original="能" pinyin="néng" calque="can"/>
    <word original="勇" pinyin="yǒng" calque="brave"/>
</line>

<line commentary="Through frugality, one can be generous.">
    <word original="儉" pinyin="jiǎn" calque="frugality"/>
    <word original="故" pinyin="gù" calque="therefore"/>
    <word original="能" pinyin="néng" calque="can"/>
    <word original="廣" pinyin="guǎng" calque="broad"/>
