<chapter number="67">
<line commentary="All under heaven say I am great while seeming unlike it.">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="下" pinyin="xià" calque="below"/>
    <word original="皆" pinyin="jiē" calque="all"/>
    <word original="謂" pinyin="wèi" calque="say"/>
    <word original="我" pinyin="wǒ" calque="I"/>
    <word original="__" pinyin="" calque="..." punctuation="true"/>
    <word original="大" pinyin="dà" calque="great"/>
</line>

<line commentary="Appearing unlike greatness.">
    <word original="似" pinyin="sì" calque="seem"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="肖" pinyin="xiào" calque="resemble"/>
</line>

<line commentary="Precisely because of not resembling greatness, one can be truly great.">
    <word original="(.)夫" pinyin="fú" calque="(indeed)"/>
    <word original="唯" pinyin="wéi" calque="only"/>
    <word original="(不肖)" pinyin="bùxiào" calque="(not-resemble)"/>
