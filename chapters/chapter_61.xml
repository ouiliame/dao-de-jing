<?xml version="1.0" encoding="UTF-8"?>
<chapter number="61">
<line commentary="A great state is like the lower reaches of a river.">
    <word original="大" pinyin="dà" calque="great"/>
    <word original="國" pinyin="guó" calque="state"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="下" pinyin="xià" calque="lower"/>
    <word original="流" pinyin="liú" calque="flow"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="It is the meeting point of all under heaven.">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="下" pinyin="xià" calque="below"/>
    <word original="之" pinyin="zhī" calque="of"/>
    <word original="交" pinyin="jiāo" calque="intersection"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="It is the feminine principle of all under heaven.">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="下" pinyin="xià" calque="below"/>
    <word original="之" pinyin="zhī" calque="of"/>
    <word original="牝" pinyin="pìn" calque="female"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="The female always overcomes the male through stillness.">
    <word original="牝" pinyin="pìn" calque="female"/>
    <word original="常" pinyin="cháng" calque="always"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="靜" pinyin="jìng" calque="stillness"/>
    <word original="勝" pinyin="shèng" calque="overcome"/>
    <word original="牡" pinyin="mǔ" calque="male"/>
</line>

<line commentary="Through stillness, she takes the lower position.">
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="靜" pinyin="jìng" calque="stillness"/>
    <word original="為" pinyin="wéi" calque="become"/>
    <word original="下" pinyin="xià" calque="lower"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Therefore when a great state lowers itself before a small state,">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="大" pinyin="dà" calque="great"/>
    <word original="國" pinyin="guó" calque="state"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="下" pinyin="xià" calque="lower"/>
    <word original="小" pinyin="xiǎo" calque="small"/>
    <word original="國" pinyin="guó" calque="state"/>
</line>

<line commentary="It will win over the small state.">
    <word original="則" pinyin="zé" calque="then"/>
    <word original="取" pinyin="qǔ" calque="gain"/>
    <word original="小" pinyin="xiǎo" calque="small"/>
    <word original="國" pinyin="guó" calque="state"/>
</line>

<line commentary="When a small state lowers itself before a great state,">
    <word original="小" pinyin="xiǎo" calque="small"/>
    <word original="國" pinyin="guó" calque="state"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="下" pinyin="xià" calque="lower"/>
    <word original="大" pinyin="dà" calque="great"/>
    <word original="國" pinyin="guó" calque="state"/>
</line>

<line commentary="It will be taken by the great state.">
    <word original="則" pinyin="zé" calque="then"/>
    <word original="取" pinyin="qǔ" calque="gain"/>
    <word original="[於]" pinyin="yú" calque="[by]"/>
    <word original="大" pinyin="dà" calque="great"/>
    <word original="國" pinyin="guó" calque="state"/>
</line>

<line commentary="Therefore, some lower themselves to gain,">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="或" pinyin="huò" calque="some"/>
    <word original="下" pinyin="xià" calque="lower"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="取" pinyin="qǔ" calque="gain"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="And some lower themselves and gain.">
    <word original="或" pinyin="huò" calque="some"/>
    <word original="下" pinyin="xià" calque="lower"/>
    <word original="而" pinyin="ér" calque="and"/>
    <word original="取" pinyin="qǔ" calque="gain"/>
</line>

<line commentary="The great state desires nothing more than to gather and nurture people.">
    <word original="大" pinyin="dà" calque="great"/>
    <word original="國" pinyin="guó" calque="state"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="過" pinyin="guò" calque="exceed"/>
    <word original="欲" pinyin="yù" calque="desire"/>
    <word original="兼" pinyin="jiān" calque="unite"/>
    <word original="畜" pinyin="chù" calque="nurture"/>
    <word original="人" pinyin="rén" calque="people"/>
</line>

<line commentary="The small state desires nothing more than to serve others.">
    <word original="小" pinyin="xiǎo" calque="small"/>
    <word original="國" pinyin="guó" calque="state"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="過" pinyin="guò" calque="exceed"/>
    <word original="欲" pinyin="yù" calque="desire"/>
    <word original="入" pinyin="rù" calque="enter"/>
    <word original="事" pinyin="shì" calque="serve"/>
    <word original="人" pinyin="rén" calque="people"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Thus both get what they desire.">
    <word original="夫" pinyin="fú" calque="indeed"/>
    <word original="兩" pinyin="liǎng" calque="both"/>
    <word original="者" pinyin="zhě" calque="ones"/>
    <word original="各" pinyin="gè" calque="each"/>
    <word original="得" pinyin="dé" calque="obtain"/>
    <word original="[其]" pinyin="qí" calque="[their]"/>
    <word original="所" pinyin="suǒ" calque="that-which"/>
    <word original="欲" pinyin="yù" calque="desire"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="The greater one should take the lower position.">
    <word original="大" pinyin="dà" calque="great"/>
    <word original="者" pinyin="zhě" calque="one"/>
    <word original="宜" pinyin="yí" calque="should"/>
    <word original="為" pinyin="wéi" calque="become"/>
