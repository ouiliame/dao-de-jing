<?xml version="1.0" encoding="UTF-8"?>
<chapter number="39">
<line commentary="Those who attained the One in ancient times:">
    <word original="昔" pinyin="xī" calque="ancient"/>
    <word original="之" pinyin="zhī" calque="of"/>
    <word original="得" pinyin="dé" calque="attain"/>
    <word original="一" pinyin="yī" calque="one"/>
    <word original="者" pinyin="zhě" calque="those-who"/>
</line>

<line commentary="Heaven attained the One and became pure.">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="得" pinyin="dé" calque="attain"/>
    <word original="一" pinyin="yī" calque="one"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="清" pinyin="qīng" calque="pure"/>
</line>

<line commentary="Earth attained the One and became stable.">
    <word original="地" pinyin="dì" calque="earth"/>
    <word original="得" pinyin="dé" calque="attain"/>
    <word original="一" pinyin="yī" calque="one"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="寧" pinyin="níng" calque="peaceful"/>
</line>

<line commentary="Spirits attained the One and became powerful.">
    <word original="神" pinyin="shén" calque="spirit"/>
    <word original="得" pinyin="dé" calque="attain"/>
    <word original="一" pinyin="yī" calque="one"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="靈" pinyin="líng" calque="efficacious"/>
</line>

<line commentary="Valleys attained the One and became full.">
    <word original="谷" pinyin="gǔ" calque="valley"/>
    <word original="得" pinyin="dé" calque="attain"/>
    <word original="一" pinyin="yī" calque="one"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="盈" pinyin="yíng" calque="full"/>
</line>

<line commentary="Ten thousand things attained the One and came to life.">
    <word original="萬" pinyin="wàn" calque="ten-thousand"/>
    <word original="物" pinyin="wù" calque="things"/>
    <word original="得" pinyin="dé" calque="attain"/>
    <word original="一" pinyin="yī" calque="one"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="生" pinyin="shēng" calque="live"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Lords and kings attained the One and became righteous rulers of the world.">
    <word original="侯" pinyin="hóu" calque="lord"/>
    <word original="王" pinyin="wáng" calque="king"/>
    <word original="得" pinyin="dé" calque="attain"/>
    <word original="一" pinyin="yī" calque="one"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="為" pinyin="wéi" calque="become"/>
    <word original="天下" pinyin="tiān-xià" calque="under-heaven"/>
    <word original="貞" pinyin="zhēn" calque="correct"/>
</line>

<line commentary="This is what it leads to.">
    <word original="其" pinyin="qí" calque="its"/>
    <word original="致" pinyin="zhì" calque="result"/>
    <word original="之" pinyin="zhī" calque="it"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Without that which makes it pure, Heaven would risk splitting apart.">
    <word original="天" pinyin="tiān" calque="heaven"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="清" pinyin="qīng" calque="pure"/>
    <word original="將" pinyin="jiāng" calque="would"/>
    <word original="恐" pinyin="kǒng" calque="fear"/>
    <word original="裂" pinyin="liè" calque="split"/>
</line>

<line commentary="Without that which makes it stable, Earth would risk bursting open.">
    <word original="地" pinyin="dì" calque="earth"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="寧" pinyin="níng" calque="peaceful"/>
    <word original="將" pinyin="jiāng" calque="would"/>
    <word original="恐" pinyin="kǒng" calque="fear"/>
    <word original="發" pinyin="fā" calque="burst"/>
</line>

<line commentary="Without that which makes them powerful, spirits would risk fading away.">
    <word original="神" pinyin="shén" calque="spirit"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="靈" pinyin="líng" calque="efficacious"/>
    <word original="將" pinyin="jiāng" calque="would"/>
    <word original="恐" pinyin="kǒng" calque="fear"/>
    <word original="歇" pinyin="xiē" calque="cease"/>
</line>

<line commentary="Without that which makes them full, valleys would risk drying up.">
    <word original="谷" pinyin="gǔ" calque="valley"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="盈" pinyin="yíng" calque="full"/>
    <word original="將" pinyin="jiāng" calque="would"/>
    <word original="恐" pinyin="kǒng" calque="fear"/>
    <word original="竭" pinyin="jié" calque="exhaust"/>
</line>

<line commentary="Without that which gives them life, the ten thousand things would risk extinction.">
    <word original="萬" pinyin="wàn" calque="ten-thousand"/>
    <word original="物" pinyin="wù" calque="things"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="生" pinyin="shēng" calque="live"/>
    <word original="將" pinyin="jiāng" calque="would"/>
    <word original="恐" pinyin="kǒng" calque="fear"/>
    <word original="滅" pinyin="miè" calque="extinguish"/>
</line>

<line commentary="Without that which makes them noble and high, lords and kings would risk falling.">
    <word original="侯" pinyin="hóu" calque="lord"/>
    <word original="王" pinyin="wáng" calque="king"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="貴" pinyin="guì" calque="noble"/>
    <word original="高" pinyin="gāo" calque="high"/>
    <word original="將" pinyin="jiāng" calque="would"/>
    <word original="恐" pinyin="kǒng" calque="fear"/>
    <word original="蹶" pinyin="jué" calque="stumble"/>
</line>

<line commentary="Therefore, the noble takes the humble as its root.">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="貴" pinyin="guì" calque="noble"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="賤" pinyin="jiàn" calque="humble"/>
    <word original="為" pinyin="wéi" calque="make"/>
    <word original="本" pinyin="běn" calque="root"/>
</line>

<line commentary="The high takes the low as its foundation.">
    <word original="高" pinyin="gāo" calque="high"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="下" pinyin="xià" calque="low"/>
    <word original="為" pinyin="wéi" calque="make"/>
    <word original="基" pinyin="jī" calque="foundation"/>
</line>

<line commentary="Thus lords and kings call themselves 'orphaned,' 'widowed,' and 'unworthy.'">
    <word original="是" pinyin="shì" calque="this"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="侯" pinyin="hóu" calque="lord"/>
    <word original="王" pinyin="wáng" calque="king"/>
    <word original="自" pinyin="zì" calque="self"/>
    <word original="謂" pinyin="wèi" calque="call"/>
    <word original="孤" pinyin="gū" calque="orphaned"/>
    <word original="寡" pinyin="guǎ" calque="widowed"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="穀" pinyin="gǔ" calque="worthy"/>
</line>

<line commentary="Is this not taking the humble as root?">
    <word original="此" pinyin="cǐ" calque="this"/>
    <word original="非" pinyin="fēi" calque="not"/>
    <word original="以" pinyin="yǐ" calque="by-means-of"/>
    <word original="賤" pinyin="jiàn" calque="humble"/>
    <word original="為" pinyin="wéi" calque="make"/>
    <word original="本" pinyin="běn" calque="root"/>
    <word original="(邪(.))" pinyin="yé" calque="(is-it-not)"/>
</line>

<line commentary="Is it not so?">
    <word original="非" pinyin="fēi" calque="not"/>
    <word original="乎" pinyin="hū" calque="question"/>
    <word original="(.)" pinyin="" calque="(.)" punctuation="true"/>
</line>

<line commentary="Therefore, the highest honor is no honor.">
    <word original="(.)故" pinyin="gù" calque="therefore"/>
    <word original="致" pinyin="zhì" calque="ultimate"/>
    <word original="數" pinyin="shù" calque="count"/>
    <word original="輿" pinyin="yú" calque="carriage"/>
    <word original="無" pinyin="wú" calque="no"/>
    <word original="輿" pinyin="yú" calque="carriage"/>
</line>

<line commentary="Do not desire to shine like jade,">
    <word original="不" pinyin="bù" calque="not"/>
    <word original="欲" pinyin="yù" calque="desire"/>
    <word original="琭" pinyin="lù" calque="glossy"/>
    <word original="琭" pinyin="lù" calque="glossy"/>
    <word original="如" pinyin="rú" calque="like"/>
    <word original="玉" pinyin="yù" calque="jade"/>
</line>

<line commentary="But be as ordinary as stone.">
    <word original="珞" pinyin="luò" calque="plain"/>
    <word original="珞" pinyin="luò" calque="plain"/>
    <word original="如" pinyin="rú" calque="like"/>
    <word original="石" pinyin="shí" calque="stone"/>
</line>
</chapter>