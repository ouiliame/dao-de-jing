<?xml version="1.0" encoding="UTF-8"?>
<chapter number="24">
<line commentary="One who stands on tiptoe cannot stand firm.">
    <word original="企" pinyin="qǐ" calque="tiptoe"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="立" pinyin="lì" calque="stand"/>
</line>

<line commentary="One who strides cannot walk far.">
    <word original="跨" pinyin="kuà" calque="stride"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="行" pinyin="xíng" calque="walk"/>
</line>

<line commentary="One who displays himself does not shine.">
    <word original="自" pinyin="zì" calque="self"/>
    <word original="見" pinyin="jiàn" calque="see"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="明" pinyin="míng" calque="bright"/>
</line>

<line commentary="One who asserts himself is not distinguished.">
    <word original="自" pinyin="zì" calque="self"/>
    <word original="是" pinyin="shì" calque="right"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="彰" pinyin="zhāng" calque="manifest"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="One who boasts of himself achieves no merit.">
    <word original="自" pinyin="zì" calque="self"/>
    <word original="伐" pinyin="fà" calque="boast"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="無" pinyin="wú" calque="without"/>
    <word original="功" pinyin="gōng" calque="merit"/>
</line>

<line commentary="One who is proud of himself does not endure.">
    <word original="自" pinyin="zì" calque="self"/>
    <word original="矜" pinyin="jīn" calque="pride"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="長" pinyin="cháng" calque="endure"/>
</line>

<line commentary="In relation to the Way, these are called:">
    <word original="其" pinyin="qí" calque="it"/>
    <word original="在" pinyin="zài" calque="in"/>
    <word original="道" pinyin="dào" calque="way"/>
    <word original="也" pinyin="yě" calque="indeed"/>
    <word original="(." pinyin="" calque="(." punctuation="true"/>
</line>

<line commentary="Excess food and unnecessary actions.">
    <word original="曰" pinyin="yuē" calque="called"/>
    <word original="餘" pinyin="yú" calque="excess"/>
    <word original="食" pinyin="shí" calque="food"/>
    <word original="贅" pinyin="zhuì" calque="superfluous"/>
    <word original="行" pinyin="xíng" calque="action"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>

<line commentary="Such things are despised by all creatures.">
    <word original="物" pinyin="wù" calque="things"/>
    <word original="或" pinyin="huò" calque="perhaps"/>
    <word original="惡" pinyin="wù" calque="despise"/>
    <word original="之" pinyin="zhī" calque="them"/>
</line>

<line commentary="Therefore, one who follows the Way does not dwell in them.">
    <word original="(." pinyin="" calque="(." punctuation="true"/>
    <word original="故" pinyin="gù" calque="therefore"/>
    <word original="有" pinyin="yǒu" calque="have"/>
    <word original="道" pinyin="dào" calque="way"/>
    <word original="者" pinyin="zhě" calque="one-who"/>
    <word original="不" pinyin="bù" calque="not"/>
    <word original="處" pinyin="chǔ" calque="dwell"/>
    <word original="." pinyin="" calque="." punctuation="true"/>
</line>
</chapter>